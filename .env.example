# Automatic Navidrome scan after each download (Subsonic/Navidrome user).
# Leave empty to disable. A "$" in a value is written "$$" (Docker Compose).
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USER=admin
NAVIDROME_PASS=password

# Weekly download of the ListenBrainz "Weekly Exploration" playlist.
# Token: ListenBrainz profile page → User token. Leave empty to disable.
LISTENBRAINZ_USER=
LISTENBRAINZ_TOKEN=
# Delete undecided tracks after this many days (0 = never).
LISTENBRAINZ_RETENTION_DAYS=0
# Interval in hours between two checks for a new playlist.
LISTENBRAINZ_CHECK_HOURS=6
# Cumulative Navidrome playlist that receives the tracks (created if missing).
# Without Navidrome, one .m3u file per week is written to Playlists/.
# LISTENBRAINZ_PLAYLIST_NAME=Weekly Exploration
