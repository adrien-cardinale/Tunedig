# Scan Navidrome automatique après chaque téléchargement (utilisateur Subsonic/Navidrome).
# Laisser vide pour désactiver.
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USER=admin
NAVIDROME_PASS=motdepasse

# Téléchargement hebdomadaire de la playlist ListenBrainz « Weekly Exploration ».
# Token : page profil ListenBrainz → User token. Laisser vide pour désactiver.
LISTENBRAINZ_USER=
LISTENBRAINZ_TOKEN=
# Supprime les pistes non triées après ce nombre de jours (0 = jamais).
LISTENBRAINZ_RETENTION_DAYS=0
# Intervalle en heures entre deux vérifications d'une nouvelle playlist.
LISTENBRAINZ_CHECK_HOURS=6
